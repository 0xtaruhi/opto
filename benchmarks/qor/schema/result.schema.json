{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://opto.dev/schema/qor-result-v1.json",
  "title": "Opto public qualification result",
  "description": "Normalized output of the Rust regression and QoR harness.",
  "_comment": "SPDX-FileCopyrightText: 2026 Zhengyi Zhang; SPDX-License-Identifier: GPL-3.0-only",
  "type": "object",
  "additionalProperties": false,
  "required": ["format", "suite", "opto", "results"],
  "properties": {
    "format": { "const": 1 },
    "suite": { "type": "string", "minLength": 1 },
    "opto": { "$ref": "#/$defs/toolIdentity" },
    "yosys": { "$ref": "#/$defs/toolIdentity" },
    "results": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/result" }
    }
  },
  "$defs": {
    "toolIdentity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "sha256", "version"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "sha256": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
        "version": { "type": "string", "minLength": 1 }
      }
    },
    "metrics": {
      "type": "object",
      "additionalProperties": false,
      "required": ["wall_seconds", "user_seconds", "system_seconds", "cpu_seconds", "peak_rss_kib"],
      "properties": {
        "wall_seconds": { "type": "number", "minimum": 0 },
        "user_seconds": { "type": "number", "minimum": 0 },
        "system_seconds": { "type": "number", "minimum": 0 },
        "cpu_seconds": { "type": "number", "minimum": 0 },
        "peak_rss_kib": { "type": "integer", "minimum": 0 }
      }
    },
    "toolResult": {
      "type": "object",
      "additionalProperties": false,
      "required": ["area", "cells", "cell_histogram", "metrics"],
      "properties": {
        "area": { "type": "number", "minimum": 0 },
        "cells": { "type": "integer", "minimum": 0 },
        "cell_histogram": {
          "type": "object",
          "minProperties": 1,
          "propertyNames": { "minLength": 1 },
          "additionalProperties": { "type": "integer", "minimum": 1 }
        },
        "metrics": { "$ref": "#/$defs/metrics" },
        "timing": { "$ref": "#/$defs/timing" }
      }
    },
    "timing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["clock_period", "critical_delay", "worst_slack", "total_negative_slack", "violating_paths"],
      "properties": {
        "clock_period": { "type": "number", "exclusiveMinimum": 0 },
        "critical_delay": { "type": "number", "minimum": 0 },
        "worst_slack": { "type": "number" },
        "total_negative_slack": { "type": "number", "maximum": 0 },
        "violating_paths": { "type": "integer", "minimum": 0 }
      }
    },
    "result": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "kind", "status", "inputs", "equivalence"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "kind": { "enum": ["regression", "qor", "upstream"] },
        "status": { "enum": ["pass", "fail"] },
        "diagnostics": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "inputs": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": { "type": "string", "pattern": "^[0-9a-f]{64}$" }
        },
        "category": { "type": "string", "minLength": 1 },
        "class": { "type": "string", "minLength": 1 },
        "scenario": { "enum": ["area_unconstrained", "timing_constrained"] },
        "opto": { "$ref": "#/$defs/toolResult" },
        "yosys_abc": { "$ref": "#/$defs/toolResult" },
        "equivalence": {
          "enum": ["pass", "fail", "not_requested", "not_available"]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": { "status": { "const": "fail" } },
            "required": ["status"]
          },
          "then": { "required": ["diagnostics"] },
          "else": { "not": { "required": ["diagnostics"] } }
        },
        {
          "if": {
            "properties": { "kind": { "const": "qor" } },
            "required": ["kind"]
          },
          "then": { "required": ["class", "scenario"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "qor" },
              "status": { "const": "pass" }
            },
            "required": ["kind", "status"]
          },
          "then": { "required": ["opto", "yosys_abc"] }
        },
        {
          "if": {
            "properties": {
              "kind": { "const": "qor" },
              "status": { "const": "pass" },
              "scenario": { "const": "timing_constrained" }
            },
            "required": ["kind", "status", "scenario"]
          },
          "then": {
            "properties": {
              "opto": { "required": ["timing"] },
              "yosys_abc": { "required": ["timing"] }
            }
          }
        }
      ]
    }
  }
}
